# 构建期生成两个文件（由 CMake 的 add_custom_command 调用）：
#
#   ${OUT_RC}        dademain.rc        —— 资源定义
#   ${OUT_MANIFEST}  tools_manifest.txt —— <资源名>|<相对路径>，运行时按它解压
#
# 规则：res/payload/ 下**任意文件**（含子目录、任意扩展名）都会被
#       - 复制成 ASCII 名字（PAYLOAD_n.bin）放到 stage 目录
#       - 打包成一条 RCDATA 资源 PAYLOAD_n 指向 stage 里的副本
#       - 在清单里登记一行 PAYLOAD_n|<原始相对路径>
#
# 为什么要 stage：rc.exe 按 ANSI 代码页解析 .rc 里的路径，
# 遇到 中文名 / 空格 / 特殊字符 会直接 RC2135 file not found。
# 资源指向 ASCII 副本、清单里保留原始名字（清单是数据，由程序读，不受 rc 影响）。
#
# 需要的变量：RES_DIR、OUT_RC、OUT_MANIFEST

set(PAYLOAD_DIR "${RES_DIR}/payload")

get_filename_component(outDir "${OUT_RC}" DIRECTORY)
set(STAGE_DIR "${outDir}/payload_stage")

set(rc "// Generated by cmake/gen_res.cmake -- do not edit.\n")
string(APPEND rc "// Resource names must not be quoted: rc.exe keeps the quotes as part\n")
string(APPEND rc "// of the name and FindResourceW() then fails with 1814.\n\n")

# 固定资源
string(APPEND rc "README_HTML RCDATA \"${RES_DIR}/readme.html\"\n")
string(APPEND rc "CFG_DADE    RCDATA \"${RES_DIR}/default.dade\"\n")

# 清单资源必须指向构建目录里刚生成的那份
string(APPEND rc "TOOLS_MANIFEST RCDATA \"${OUT_MANIFEST}\"\n\n")

set(manifest "; 由 cmake/gen_res.cmake 生成：每行是 <资源名> 与 <相对路径>，用竖线分隔\n")

# 默认配置也走解压流程（.dade 已存在时解压器会跳过，不覆盖用户修改）
string(APPEND manifest "CFG_DADE|.dade\n")

# 载荷：res/payload/ 下所有文件
file(REMOVE_RECURSE "${STAGE_DIR}")
file(MAKE_DIRECTORY "${STAGE_DIR}")

if(EXISTS "${PAYLOAD_DIR}")
    file(GLOB_RECURSE payloadFiles RELATIVE "${PAYLOAD_DIR}" "${PAYLOAD_DIR}/*")
    list(SORT payloadFiles)

    set(idx 0)
    foreach(rel ${payloadFiles})
        math(EXPR idx "${idx} + 1")
        set(resName "PAYLOAD_${idx}")

        # 按字节复制成 ASCII 名字，避免 rc.exe 处理非 ASCII 路径
        configure_file("${PAYLOAD_DIR}/${rel}" "${STAGE_DIR}/${resName}.bin" COPYONLY)

        string(APPEND rc "${resName} RCDATA \"${STAGE_DIR}/${resName}.bin\"\n")
        string(APPEND manifest "${resName}|${rel}\n")
    endforeach()

    message(STATUS "载荷文件 ${idx} 个 -> ${STAGE_DIR}")
else()
    message(WARNING "找不到 ${PAYLOAD_DIR}，将不打包任何载荷")
endif()

file(WRITE "${OUT_MANIFEST}" "${manifest}")
file(WRITE "${OUT_RC}" "${rc}")
